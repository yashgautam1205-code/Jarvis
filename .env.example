# JARVIS works without developer API credentials.

# Local AI (default). Install Ollama and download this model from JARVIS Settings.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b

# Optional hosted AI. Used only after explicitly selecting OpenAI in Settings.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Keyless HTML web search. Replace with a trusted engine URL if desired.
# Use {query} where the encoded search terms should be inserted.
SEARCH_PROVIDER=duckduckgo
SEARCH_ENGINE_URL=https://html.duckduckgo.com/html/?q={query}
SEARCH_TIMEOUT_SECONDS=10

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Voice (optional)
TTS_PROVIDER=piper
STT_PROVIDER=faster-whisper
WHISPER_MODEL=base
PIPER_EXECUTABLE=piper
PIPER_MODEL_PATH=models/en_US-lessac-medium.onnx
WAKE_WORD_ENABLED=false
WAKE_WORD_MODEL=hey_jarvis
WAKE_WORD_THRESHOLD=0.5
WAKE_WORD_COOLDOWN_SECONDS=5

# Paths
JARVIS_WORKSPACE=~/JarvisWorkspace
ALLOWED_DIRS=~/Documents,~/Desktop,~/Downloads

# Logging
LOG_LEVEL=INFO
